# ──────────────────────────────────────────────────────────────────────────
# Agentforce proxy configuration
#
# 1. Copy this file to ".env"   →   cp .env.example .env   (Windows: copy .env.example .env)
# 2. Fill in the 4 values from YOUR Salesforce org (see README "Get your values").
# 3. NEVER commit the real .env — it is gitignored. This .env.example is safe to
#    share because it only contains placeholders.
# ──────────────────────────────────────────────────────────────────────────

# Your Salesforce My Domain host, WITHOUT https://
# Find it in Setup → My Domain (e.g. acme.my.salesforce.com).
SF_MY_DOMAIN_URL=your-domain.my.salesforce.com

# Agent API host. Leave as-is for most orgs; use api.gov.salesforce.com for Gov Cloud.
SF_API_HOST=api.salesforce.com

# The Agentforce agent (bot) ID — an 18-char ID starting with 0Xx.
# Find it in the URL of the agent in Agent Builder, or via the Agents setup page.
SF_AGENT_ID=0XxXXXXXXXXXXXXXXX

# Connected App credentials (OAuth 2.0 Client Credentials flow).
# Setup → App Manager → your Connected App → Manage Consumer Details.
SF_CLIENT_ID=your-connected-app-consumer-key
SF_CLIENT_SECRET=your-connected-app-consumer-secret

# ── Server options (usually fine as-is) ───────────────────────────────────
# Port the proxy listens on.
PORT=8787

# CORS: the exact origin of your frontend if you host it separately.
# Use * for local/dev. Example: https://yourname.github.io
ALLOWED_ORIGIN=*

# Feedback value sent to Salesforce:
#   enum  → sends API-safe GOOD/BAD + puts "[5/5 — Amazing] comment" in the text field (default)
#   label → sends the descriptive word (BAD/NOT WELL/GOOD/VERY GOOD/AMAZING) as the feedback value
FEEDBACK_MODE=enum
