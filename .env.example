# ──────────────────────────────────────────────────────────────────────────
# Agentforce proxy configuration — copy this file to ".env" and fill it in.
# These values come straight from your Postman collection variables.
# NEVER commit the real .env (it is gitignored).
# ──────────────────────────────────────────────────────────────────────────

# Your Salesforce My Domain host, WITHOUT the https:// prefix.
SF_MY_DOMAIN_URL=storm-589d4b9f356922.my.salesforce.com

# Agent API host. Use api.gov.salesforce.com for Government Cloud.
SF_API_HOST=api.salesforce.com

# The Agentforce agent (bot) ID.
SF_AGENT_ID=0XxHn0000012gowKAA

# Connected App (client credentials flow).
SF_CLIENT_ID=3MVG9OGq41FnYVsEcSXyRInzSsktc3YB9qnYGnPyvoSIRufJrLEKrDumNAmeU_dqOgN1Vh_iMr3EqBpKZqFbk
SF_CLIENT_SECRET=replace-with-your-consumer-secret

# Port the proxy listens on.
PORT=8787

# CORS: the exact origin of your deployed frontend (GitHub Pages URL).
# Use * only for local testing. Example: https://sshvarzman-salesforce.github.io
ALLOWED_ORIGIN=*

# Feedback mode: "enum" sends GOOD/BAD (safe, documented) and puts the
# descriptive label + comment in the text field. "label" sends the raw word
# (BAD/NOT WELL/GOOD/VERY GOOD/AMAZING) as the feedback value — only use this
# if your org accepts those values.
FEEDBACK_MODE=enum
